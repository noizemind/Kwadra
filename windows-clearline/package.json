{
  "name": "clearline",
  "version": "1.0.0",
  "private": true,
  "description": "Clearline — original SIP softphone for Windows",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "start": "vite build && electron .",
    "test": "node --test test/*.test.cjs",
    "dist:win": "vite build && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "app.clearline",
    "productName": "Clearline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Clearline-${version}-portable.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
